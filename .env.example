API_KEY=change-me-to-a-long-random-secret
MODEL_NAME=birefnet-general
MAX_UPLOAD_BYTES=20971520
MAX_REQUEST_BYTES=26214400
MAX_IMAGE_PIXELS=25000000
# Comma-separated exact hostnames only; empty disables URL input.
URL_ALLOWED_HOSTS=
# Per X-API-Key request rate limit across protected removal endpoints.
RATE_LIMIT_PER_MINUTE=30
# Additional requests allowed to wait behind active GPU work in this process.
MAX_PENDING_REQUESTS=4
URL_FETCH_TIMEOUT_SECONDS=15
GPU_MAX_CONCURRENCY=1
MODEL_SESSION_CACHE_SIZE=2
MODEL_CACHE_DIR=/root/.u2net
